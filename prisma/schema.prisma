generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id             String   @id
  name           String
  nameByLanguage Json
  areas          Area[]
}

model Area {
  id             String   @id
  countryId      String
  country        Country  @relation(fields: [countryId], references: [id])
  name           String
  nameByLanguage Json
  regions        Region[]
}

model Region {
  id                   String   @id
  areaId               String
  area                 Area     @relation(fields: [areaId], references: [id])
  name                 String
  nameByLanguage       Json
  centerLat            Float
  centerLng            Float
  defaultZoom          Int
  bounds               Json
  timezoneOffsetHours  Int
  sealCharacter        String
  pois                 Poi[]
}

model Poi {
  id               String   @id
  regionId         String
  region           Region   @relation(fields: [regionId], references: [id])
  name             String
  nameByLanguage   Json
  lat              Float
  lng              Float
  description      String
  rating           Float
  categories       String[]
  tags             String[]
  seasons          String[]
  photoScore       Int
  mustVisit        Boolean
  bestTime         String[]
  difficulty       String
  durationMinutes  Int
  importance       Int
  visibilityMode   String
  photos           Photo[]
}

model Photo {
  id       String  @id
  poiId    String
  poi      Poi     @relation(fields: [poiId], references: [id], onDelete: Cascade)
  url      String
  alt      String
  author   String?
  season   String?
  position Int
}
