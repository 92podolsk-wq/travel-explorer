generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id             String   @id
  name           String
  nameByLanguage Json
  areas          Area[]
}

model Area {
  id             String   @id
  countryId      String
  country        Country  @relation(fields: [countryId], references: [id])
  name           String
  nameByLanguage Json
  regions        Region[]
}

model Region {
  id                   String   @id
  areaId               String
  area                 Area     @relation(fields: [areaId], references: [id])
  name                 String
  nameByLanguage       Json
  centerLat            Float
  centerLng            Float
  defaultZoom          Int
  bounds               Json
  timezoneOffsetHours  Int
  sealCharacter        String
  pois                 Poi[]
}

model Poi {
  id               String   @id
  regionId         String
  region           Region   @relation(fields: [regionId], references: [id])
  name             String
  nameByLanguage   Json
  lat              Float
  lng              Float
  description      String
  rating           Float
  categories       String[]
  tags             String[]
  seasons          String[]
  photoScore       Int
  mustVisit        Boolean
  bestTime         String[]
  difficulty       String
  durationMinutes  Int
  importance       Int
  visibilityMode   String
  photos           Photo[]
  favoritedBy      Favorite[]
  viewedBy         ViewedPoi[]
  visitedBy        VisitedPoi[]
}

model Photo {
  id       String  @id
  poiId    String
  poi      Poi     @relation(fields: [poiId], references: [id], onDelete: Cascade)
  url      String
  alt      String
  author   String?
  season   String?
  position Int
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  sessions     Session[]
  favorites    Favorite[]
  viewedPois   ViewedPoi[]
  visitedPois  VisitedPoi[]
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId     String
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, poiId])
}

model ViewedPoi {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId    String
  poi      Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, poiId])
}

model VisitedPoi {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId     String
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@unique([userId, poiId])
}
