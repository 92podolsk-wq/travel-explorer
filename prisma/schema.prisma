generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id             String   @id
  name           String
  nameByLanguage Json
  areas          Area[]
}

model Area {
  id             String   @id
  countryId      String
  country        Country  @relation(fields: [countryId], references: [id])
  name           String
  nameByLanguage Json
  regions        Region[]
}

model Region {
  id                   String   @id
  areaId               String
  area                 Area     @relation(fields: [areaId], references: [id])
  name                 String
  nameByLanguage       Json
  centerLat            Float
  centerLng            Float
  defaultZoom          Int
  bounds               Json
  timezoneOffsetHours  Int
  sealCharacter        String
  status               String   @default("published")
  seasonWindows        Json?
  pois                 Poi[]
}

model Poi {
  id               String   @id
  regionId         String
  region           Region   @relation(fields: [regionId], references: [id])
  name             String
  nameByLanguage   Json
  lat              Float
  lng              Float
  description      String
  descriptionByLanguage Json?
  rating           Float
  categories       String[]
  tags             String[]
  seasons          String[]
  photoScore       Int
  mustVisit        Boolean
  bestTime         String[]
  difficulty       String
  durationMinutes  Int
  importance       Int
  visibilityMode   String
  status           String   @default("published")
  photos           Photo[]
  favoritedBy      Favorite[]
  viewedBy         ViewedPoi[]
  visitedBy        VisitedPoi[]
  reports          PoiReport[]
  itineraryStops   ItineraryStop[]
}

model AdminAccount {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  adminId   String
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
}

model ExplorationMode {
  id                    String @id
  position              Int
  name                  String
  nameByLanguage        Json
  description           String
  descriptionByLanguage Json
  tags                  String[]
  icon                  String
}

model Photo {
  id       String  @id
  poiId    String
  poi      Poi     @relation(fields: [poiId], references: [id], onDelete: Cascade)
  url      String
  alt      String
  author   String?
  season   String?
  position Int

  @@index([poiId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  avatarId     String?
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  sessions     Session[]
  favorites    Favorite[]
  viewedPois   ViewedPoi[]
  visitedPois  VisitedPoi[]
  poiReports   PoiReport[]
  itinerary    Itinerary?
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId     String
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, poiId])
}

model ViewedPoi {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId    String
  poi      Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, poiId])
}

model VisitedPoi {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId     String
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@unique([userId, poiId])
}

model PoiReport {
  id        String   @id @default(cuid())
  poiId     String
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Itinerary {
  id         String          @id @default(cuid())
  userId     String          @unique
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String          @default("Мой маршрут")
  shareToken String          @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  stops      ItineraryStop[]
}

model ItineraryStop {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  poiId       String
  poi         Poi       @relation(fields: [poiId], references: [id], onDelete: Cascade)
  position    Int

  @@unique([itineraryId, poiId])
}
