generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id             String   @id
  name           String
  nameByLanguage Json
  areas          Area[]
}

model Area {
  id             String   @id
  countryId      String
  country        Country  @relation(fields: [countryId], references: [id])
  name           String
  nameByLanguage Json
  regions        Region[]
}

model Region {
  id                   String   @id
  areaId               String
  area                 Area     @relation(fields: [areaId], references: [id])
  name                 String
  nameByLanguage       Json
  centerLat            Float
  centerLng            Float
  defaultZoom          Int
  bounds               Json
  timezoneOffsetHours  Int
  sealCharacter        String
  status               String   @default("published")
  seasonWindows        Json?
  pois                 Poi[]
}

model Poi {
  id               String   @id
  regionId         String
  region           Region   @relation(fields: [regionId], references: [id])
  name             String
  nameByLanguage   Json
  lat              Float
  lng              Float
  description      String
  descriptionByLanguage Json?
  rating           Float
  category         String
  tags             String[]
  seasons          String[]
  photoScore       Int
  mustVisit        Boolean
  bestTime         String[]
  bestTimeByLanguage Json?
  difficulty       String
  durationMinutes  Int
  importance       Int
  status           String   @default("published")
  deletedAt        DateTime?
  photos           Photo[]
  favoritedBy      Favorite[]
  viewedBy         ViewedPoi[]
  visitedBy        VisitedPoi[]
  reports          PoiReport[]
  itineraryStops   ItineraryStop[]
}

model AdminAccount {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  adminId   String
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
}

model ExplorationMode {
  id                    String @id
  position              Int
  name                  String
  nameByLanguage        Json
  description           String
  descriptionByLanguage Json
  tags                  String[]
  icon                  String
}

model Category {
  id             String  @id
  position       Int
  name           String
  nameByLanguage Json
  icon           String
  color          String
  isHidden       Boolean @default(false)
}

model Photo {
  id               String    @id @default(cuid())
  poiId            String
  poi              Poi       @relation(fields: [poiId], references: [id], onDelete: Cascade)
  url              String
  alt              String
  author           String?
  season           String?
  position         Int
  status           String    @default("approved")
  uploadedByUserId String?
  uploadedBy       User?     @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  storagePath      String?
  createdAt        DateTime  @default(now())

  @@index([poiId])
  @@index([status])
  @@index([uploadedByUserId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String?
  avatarId     String?
  isBlocked    Boolean  @default(false)
  canAccessHiddenCategories Boolean @default(false)
  hideFromSearch Boolean @default(false)
  createdAt    DateTime @default(now())
  sessions     Session[]
  favorites    Favorite[]
  viewedPois   ViewedPoi[]
  visitedPois  VisitedPoi[]
  poiReports   PoiReport[]
  itineraries  Itinerary[]
  customMarkers CustomMarker[]
  uploadedPhotos Photo[]
  pushTokens   PushToken[]
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
  packingChecklist       PackingChecklist?
  ownedChecklistShares   ChecklistShare[] @relation("ChecklistShareOwner")
  receivedChecklistShares ChecklistShare[] @relation("ChecklistShareRecipient")
  ownedItineraryShares   ItineraryShare[] @relation("ItineraryShareOwner")
  receivedItineraryShares ItineraryShare[] @relation("ItineraryShareRecipient")
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model PackingChecklist {
  id            String   @id @default(cuid())
  userId        String   @unique
  tripDate      DateTime?
  packingItems  Json     @default("[]")
  shoppingItems Json     @default("[]")
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChecklistShare {
  id            String   @id @default(cuid())
  ownerId       String
  sharedWithId  String
  createdAt     DateTime @default(now())
  owner         User     @relation("ChecklistShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWith    User     @relation("ChecklistShareRecipient", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([ownerId, sharedWithId])
  @@index([sharedWithId])
}

model ItineraryShare {
  id            String   @id @default(cuid())
  itineraryId   String
  ownerId       String
  sharedWithId  String
  createdAt     DateTime @default(now())
  itinerary     Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  owner         User      @relation("ItineraryShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWith    User      @relation("ItineraryShareRecipient", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([itineraryId, sharedWithId])
  @@index([sharedWithId])
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String   @default("android")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId     String
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, poiId])
}

model ViewedPoi {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId    String
  poi      Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, poiId])
}

model VisitedPoi {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poiId     String
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())

  @@unique([userId, poiId])
}

model PoiReport {
  id        String   @id @default(cuid())
  poiId     String
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Itinerary {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String          @default("Мой маршрут")
  shareToken String          @unique
  startDate  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  stops      ItineraryStop[]
  days       ItineraryDay[]
  shares     ItineraryShare[]

  @@index([userId])
}

model ItineraryStop {
  id                      String        @id @default(cuid())
  itineraryId             String
  itinerary               Itinerary     @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  poiId                   String?
  poi                     Poi?          @relation(fields: [poiId], references: [id], onDelete: Cascade)
  customMarkerId          String?
  customMarker            CustomMarker? @relation(fields: [customMarkerId], references: [id], onDelete: Cascade)
  day                     Int           @default(1)
  position                Int
  durationOverrideMinutes Int?

  @@unique([itineraryId, poiId])
  @@unique([itineraryId, customMarkerId])
}

model ItineraryDay {
  id                   String    @id @default(cuid())
  itineraryId          String
  itinerary            Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  day                  Int
  title                String?
  startMinutes         Int?
  lunchEnabled         Boolean?
  lunchStartMinutes    Int?
  lunchDurationMinutes Int?

  @@unique([itineraryId, day])
}

model SiteSetting {
  id                             String   @id @default("singleton")
  mapStyleId                     String   @default("openfreemap-bright")
  protomapsPmtilesUrl            String?
  maxCustomMarkersPerUser        Int      @default(200)
  maxPhotoUploadsPerUserPerDay   Int      @default(5)
  maxPhotoUploadsSiteWidePerDay  Int      @default(200)
  updatedAt                      DateTime @updatedAt
}

model CustomMarker {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat            Float
  lng            Float
  color          String
  label          String          @default("")
  createdAt      DateTime        @default(now())
  itineraryStops ItineraryStop[]

  @@index([userId])
}
